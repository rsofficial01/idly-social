# secrets: never commit tokens (they live in IG_TOKEN_* / IG_SYSTEM_TOKEN env vars or a network secret)
state/secrets/
.env
.env.*
*.token

# caches and scratch space
__pycache__/
*.py[cod]
.pytest_cache/
_work/

# posts/ keeps only the JPEGs Instagram fetches
posts/**/*.png

# committed on purpose: posts/**/*.jpg, state/posted.json, state/accounts.json (ids and hosts, no tokens), reports/
